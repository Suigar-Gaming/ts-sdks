{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"pedantic": "warn",
		"perf": "error",
		"suspicious": "error"
	},
	"ignorePatterns": ["**/*.{m,c}js"],
	"options": {
		"typeAware": true
	},
	"plugins": [
		"eslint",
		"typescript",
		"unicorn",
		"react",
		"react-perf",
		"oxc",
		"import",
		"jsx-a11y",
		"vitest",
		"node",
		"promise"
	],
	"rules": {
		"curly": ["warn", "all"],
		// Nullish checks deliberately match both null and undefined.
		"eqeqeq": ["warn", "always", { "null": "ignore" }],
		"import/consistent-type-specifier-style": ["warn", "prefer-top-level-if-only-type-imports"],
		"import/extensions": [
			"error",
			"always",
			{
				"ignorePackages": true
			}
		],
		"import/max-dependencies": "off",
		"import/no-duplicates": [
			"warn",
			{
				"preferInline": true
			}
		],
		"import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
		"max-lines": "off",
		"max-lines-per-function": "off",
		"no-await-in-loop": "error",
		// Protocol fields and injected build/debug globals have fixed external names.
		"no-underscore-dangle": [
			"error",
			{
				"allow": [
					"_meta",
					"_registeredTools",
					"_registeredResources",
					"__SUIFREN_ANIMATION_BACKEND__",
					"__SUIGAR_MCP_APP_VERSION__"
				]
			}
		],
		"no-unused-vars": [
			"error",
			{
				"reportUsedIgnorePattern": true,
				"caughtErrorsIgnorePattern": "^_"
			}
		],
		// Copies in map callbacks preserve immutable state and input objects.
		"oxc/no-map-spread": "off",
		// The final callback may perform side effects when its return value is unused.
		"promise/always-return": ["warn", { "ignoreLastCallback": true }],
		// Inline props alone do not establish a need for memoization.
		"react-perf/jsx-no-jsx-as-prop": "off",
		"react-perf/jsx-no-new-array-as-prop": "off",
		"react-perf/jsx-no-new-function-as-prop": "off",
		"react-perf/jsx-no-new-object-as-prop": "off",
		// All workspaces use the automatic react-jsx transform.
		"react/react-in-jsx-scope": "off",
		// The type-aware rule accepts async functions that return promises.
		"require-await": "off",
		"sort-imports": [
			"warn",
			{
				"ignoreCase": true,
				"ignoreDeclarationSort": true
			}
		],
		"typescript/array-type": [
			"warn",
			{
				"default": "generic"
			}
		],
		// Already enforced by TypeScript noImplicitReturns.
		"typescript/consistent-return": "off",
		"typescript/consistent-type-imports": "warn",
		"typescript/no-deprecated": "warn",
		"typescript/no-unnecessary-type-assertion": "warn",
		"typescript/prefer-readonly-parameter-types": "off",
		"typescript/switch-exhaustiveness-check": [
			"warn",
			{ "considerDefaultExhaustiveForUnions": true }
		]
	},
	"overrides": [
		{
			// Generated bindings are maintained by sui-ts-codegen, not edited manually.
			"files": ["packages/*/src/contracts/**/*.ts"],
			"rules": {
				"curly": "off",
				"import/consistent-type-specifier-style": "off",
				"max-classes-per-file": "off",
				"require-unicode-regexp": "off",
				"sort-imports": "off",
				"typescript/ban-types": "off",
				"typescript/no-base-to-string": "off",
				"typescript/no-unnecessary-type-assertion": "off",
				"typescript/no-unsafe-assignment": "off",
				"typescript/no-unsafe-return": "off",
				"typescript/no-unsafe-type-assertion": "off",
				"typescript/restrict-template-expressions": "off",
				"typescript/strict-boolean-expressions": "off"
			}
		}
	]
}
