{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"options": {
		"typeAware": true
	},
	"plugins": [
		"eslint",
		"typescript",
		"unicorn",
		"react",
		"react-perf",
		"oxc",
		"import",
		"jsx-a11y",
		"vitest",
		"node",
		"promise"
	],
	"ignorePatterns": [
		"node_modules",
		"dist",
		"packages/*/dist",
		"playground",
		".changeset/*.md"
	],
	"rules": {
		"import/extensions": [
			"error",
			"always",
			{
				"ignorePackages": true
			}
		],
		"no-unused-vars": [
			"error",
			{
				"reportUsedIgnorePattern": true,
				"caughtErrorsIgnorePattern": "^_"
			}
		],
		"typescript/array-type": [
			"warn",
			{
				"default": "generic"
			}
		],
		"typescript/no-deprecated": "warn"
	},
	"overrides": [
		{
			"files": ["packages/*/src/contracts/**/*.ts"],
			"rules": {
				"typescript/no-base-to-string": "off",
				"typescript/restrict-template-expressions": "off"
			}
		}
	]
}
