{
	"name": "@suigar/ts-sdks",
	"private": true,
	"license": "Apache-2.0",
	"author": "Suigar Gaming <contact.suigar@gmail.com>",
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"build": "turbo run build",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"changeset": "changeset",
		"changeset:prerelease:beta": "changeset pre enter beta",
		"changeset:prerelease:exit": "changeset pre exit",
		"changeset:version": "changeset version && pnpm run codegen:version && pnpm --filter './packages/*' --if-present run codegen:version",
		"codegen:version": "node scripts/genversion.mjs",
		"publish:jsr": "node scripts/publish-jsr.mjs",
		"release": "turbo run build:ci --filter='./packages/*' && changeset publish && pnpm run publish:jsr",
		"oxlint": "oxlint .",
		"oxlint:fix": "oxlint . --fix",
		"oxfmt": "oxfmt . --check",
		"oxfmt:fix": "oxfmt .",
		"lint": "pnpm run oxlint && pnpm run oxfmt",
		"lint:fix": "pnpm run oxlint:fix && pnpm run oxfmt:fix"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@changesets/config": "^4.0.1",
		"@manypkg/cli": "^0.25.1",
		"husky": "^9.1.7",
		"jsr": "^0.14.3",
		"lint-staged": "^17.5.1",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"oxlint-tsgolint": "^7.0.2002",
		"rimraf": "^6.1.3",
		"turbo": "^2.10.13"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
			"onFail": "warn"
		},
		"runtime": {
			"name": "node",
			"version": "^24.18.0 || ^26.5.0",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
