{
	"name": "@suigar/ts-sdks",
	"private": true,
	"license": "Apache-2.0",
	"author": "Suigar Gaming <contact.suigar@gmail.com>",
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"build": "turbo run build",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"changeset": "changeset",
		"changeset:prerelease:beta": "changeset pre enter beta",
		"changeset:prerelease:exit": "changeset pre exit",
		"changeset:version": "changeset version && pnpm run codegen:version && pnpm --filter './packages/*' --if-present run codegen:version",
		"codegen:version": "node scripts/genversion.mjs",
		"publish:jsr": "node scripts/publish-jsr.mjs",
		"release": "turbo run build:ci --filter='./packages/*' && changeset publish && pnpm run publish:jsr",
		"oxlint": "oxlint .",
		"oxlint:fix": "oxlint . --fix",
		"oxfmt": "oxfmt . --check",
		"oxfmt:fix": "oxfmt .",
		"lint": "pnpm run oxlint && pnpm run oxfmt",
		"lint:fix": "pnpm run oxlint:fix && pnpm run oxfmt:fix"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.1",
		"@changesets/config": "^4.0.0",
		"@manypkg/cli": "^0.25.1",
		"husky": "^9.1.7",
		"jsr": "^0.14.3",
		"lint-staged": "^17.4.1",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"oxlint-tsgolint": "^7.0.2001",
		"rimraf": "^6.1.3",
		"turbo": "^2.10.12"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
			"onFail": "warn"
		},
		"runtime": {
			"name": "node",
			"version": "^24.18.0 || ^26.5.0",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
