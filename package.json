{
	"name": "@suigar/ts-sdks",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^22.18.0 || >=24.0.0",
			"onFail": "warn"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
			"onFail": "warn"
		}
	},
	"scripts": {
		"prepare": "husky",
		"build": "turbo run build",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"changeset": "changeset",
		"changeset:beta:enter": "changeset pre enter beta",
		"changeset:beta:exit": "changeset pre exit",
		"changeset:version": "changeset version && pnpm --filter '@suigar/*' run codegen:version",
		"release": "turbo run build:ci --filter='./packages/*' && changeset publish",
		"oxlint": "oxlint .",
		"oxlint:fix": "oxlint . --fix",
		"prettier": "prettier --check --ignore-unknown .",
		"prettier:fix": "prettier --write --ignore-unknown .",
		"lint": "pnpm run oxlint && pnpm run prettier",
		"lint:fix": "pnpm run oxlint:fix && pnpm run prettier:fix"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@manypkg/cli": "^0.25.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"oxlint": "^1.74.0",
		"oxlint-tsgolint": "^0.25.0",
		"prettier": "catalog:tooling",
		"turbo": "^2.10.5"
	}
}
