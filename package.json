{
	"name": "@suigar/ts-sdks",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^22.18.0 || >=24.0.0",
			"onFail": "warn"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
			"onFail": "warn"
		}
	},
	"scripts": {
		"prepare": "husky",
		"build": "turbo run build",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"changeset": "changeset",
		"changeset:beta:enter": "changeset pre enter beta",
		"changeset:beta:exit": "changeset pre exit",
		"changeset:version": "changeset version && pnpm --filter '@suigar/*' run codegen:version",
		"release": "turbo run build:ci --filter='./packages/*' && changeset publish",
		"oxlint": "oxlint .",
		"oxlint:fix": "oxlint . --fix",
		"prettier": "prettier --check --ignore-unknown .",
		"prettier:fix": "prettier --write --ignore-unknown .",
		"lint": "pnpm run oxlint && pnpm run prettier",
		"lint:fix": "pnpm run oxlint:fix && pnpm run prettier:fix"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@manypkg/cli": "^0.25.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0",
		"oxlint": "^1.75.0",
		"oxlint-tsgolint": "^7.0.0021",
		"prettier": "catalog:tooling",
		"turbo": "^2.10.7"
	}
}
