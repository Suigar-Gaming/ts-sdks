{
	"name": "@suigar/ts-sdks",
	"private": true,
	"license": "Apache-2.0",
	"author": "Suigar Gaming <contact.suigar@gmail.com>",
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"build": "turbo run build",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"changeset": "changeset",
		"changeset:prerelease:beta": "changeset pre enter beta",
		"changeset:prerelease:exit": "changeset pre exit",
		"changeset:version": "changeset version && pnpm run codegen:version && pnpm --filter './packages/*' --if-present run codegen:version",
		"codegen:version": "node scripts/genversion.mjs",
		"publish:jsr": "node scripts/publish-jsr.mjs",
		"release": "turbo run build:ci --filter='./packages/*' && changeset publish && pnpm run publish:jsr",
		"oxlint": "oxlint .",
		"oxlint:fix": "oxlint . --fix",
		"oxfmt": "oxfmt . --check",
		"oxfmt:fix": "oxfmt .",
		"lint": "pnpm run oxlint && pnpm run oxfmt",
		"lint:fix": "pnpm run oxlint:fix && pnpm run oxfmt:fix"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@changesets/config": "^4.0.1",
		"@manypkg/cli": "^0.25.1",
		"husky": "^9.1.7",
		"jsr": "^0.14.3",
		"lint-staged": "^17.5.1",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"oxlint-tsgolint": "^7.0.2001",
		"rimraf": "^6.1.3",
		"turbo": "^2.10.13"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
			"onFail": "warn"
		},
		"runtime": {
			"name": "node",
			"version": "^24.18.0 || ^26.5.0",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
