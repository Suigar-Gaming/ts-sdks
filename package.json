{
	"name": "@suigar/ts-sdks",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": "^22.18.0 || >=24",
		"pnpm": ">=10.33.2"
	},
	"scripts": {
		"changeset": "changeset",
		"changeset:beta:enter": "changeset pre enter beta",
		"changeset:beta:exit": "changeset pre exit",
		"changeset:version": "changeset version",
		"eslint:fix": "eslint . --fix",
		"format": "pnpm prettier:fix",
		"lint": "pnpm eslint:fix && pnpm prettier:fix",
		"prepare": "husky",
		"prettier:fix": "prettier --write --ignore-unknown .",
		"release": "pnpm turbo run build:ci --filter='./packages/*' && changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.2",
		"prettier": "^3.8.3",
		"turbo": "^2.9.10",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.2"
	}
}
