{
	"name": "@suigar/ts-sdks",
	"private": true,
	"license": "Apache-2.0",
	"author": "Suigar Gaming <contact.suigar@gmail.com>",
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"build": "turbo run build",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"changeset": "changeset",
		"changeset:prerelease:beta": "changeset pre enter beta",
		"changeset:prerelease:exit": "changeset pre exit",
		"changeset:version": "changeset version && pnpm run codegen:version && pnpm --filter './packages/*' --if-present run codegen:version",
		"codegen:version": "node scripts/genversion.mjs",
		"publish:jsr": "node scripts/publish-jsr.mjs",
		"release": "turbo run build:ci --filter='./packages/*' && changeset publish && pnpm run publish:jsr",
		"oxlint": "oxlint .",
		"oxlint:fix": "oxlint . --fix",
		"oxfmt": "oxfmt . --check",
		"oxfmt:fix": "oxfmt .",
		"lint": "pnpm run oxlint && pnpm run oxfmt",
		"lint:fix": "pnpm run oxlint:fix && pnpm run oxfmt:fix"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@changesets/config": "^4.0.1",
		"@manypkg/cli": "^0.25.1",
		"husky": "^9.1.7",
		"jsr": "^0.14.3",
		"lint-staged": "^17.5.1",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.85.0",
		"oxlint-tsgolint": "^7.0.2002",
		"rimraf": "^6.1.3",
		"turbo": "^2.11.3"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
			"onFail": "warn"
		},
		"runtime": {
			"name": "node",
			"version": "^24.18.0 || ^26.5.0",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
