{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"extends": ["../.oxlintrc.json"],
	"plugins": [
		"eslint",
		"typescript",
		"unicorn",
		"react",
		"react-perf",
		"nextjs",
		"import",
		"jsx-a11y",
		"oxc",
		"promise"
	],
	"rules": {
		"import/extensions": "off",
		"typescript/no-explicit-any": "warn"
	}
}
