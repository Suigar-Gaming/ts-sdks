{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "all",
	"semi": true,
	"proseWrap": "never",
	"sortPackageJson": true,
	"ignorePatterns": [
		"**/.turbo/**",
		"**/.next/**",
		"**/build/**",
		"**/coverage/**",
		"**/dist/**",
		"**/out/**",
		"pnpm-lock.yaml",
		"npm-debug.log*",
		"package-lock.json",
		"yarn-debug.log*"
	],
	"sortImports": {
		"newlinesBetween": false,
		"customGroups": [
			{
				"groupName": "suigar",
				"elementNamePattern": ["@suigar/**"]
			},
			{
				"groupName": "app",
				"elementNamePattern": ["@/**"]
			}
		],
		"groups": [
			["type-builtin", "value-builtin"],
			["type-external", "value-external"],
			"suigar",
			"app",
			["type-parent", "type-sibling", "type-index", "value-parent", "value-sibling", "value-index"],
			"unknown"
		]
	}
}
