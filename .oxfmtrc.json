{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "all",
	"semi": true,
	"proseWrap": "never",
	"sortPackageJson": true,
	"jsdoc": true,
	"ignorePatterns": ["**/.next/**", "**/build/**", "**/coverage/**", "**/out/**"],
	"overrides": [
		{
			"files": ["packages/*/src/contracts/**"],
			"options": {
				"jsdoc": false,
				"sortImports": false
			}
		}
	],
	"sortImports": {
		"newlinesBetween": false,
		"customGroups": [
			{
				"groupName": "suigar",
				"elementNamePattern": ["@suigar/**"]
			},
			{
				"groupName": "app",
				"elementNamePattern": ["@/**"]
			}
		],
		"groups": [
			["type-builtin", "value-builtin"],
			["type-external", "value-external"],
			"suigar",
			"app",
			["type-parent", "type-sibling", "type-index", "value-parent", "value-sibling", "value-index"],
			"unknown"
		]
	},
	"sortTailwindcss": true
}
