{
	"name": "@suigar/mcp",
	"version": "1.0.0-beta.12",
	"description": "MCP server and MCP App for building and inspecting Suigar transactions on Sui.",
	"author": "Suigar Gaming <contact.suigar@gmail.com>",
	"keywords": [
		"suigar",
		"sui",
		"mcp",
		"mcp-app",
		"typescript",
		"move",
		"web3",
		"games"
	],
	"license": "Apache-2.0",
	"mcpName": "io.github.suigar-gaming/mcp",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"plugin",
		"CHANGELOG.md",
		"README.md"
	],
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"bin": {
		"suigar": "./dist/bin.mjs"
	},
	"engines": {
		"node": "^22.18.0 || >=24.0.0"
	},
	"scripts": {
		"build": "pnpm run clean && tsdown && vite build",
		"build:ci": "pnpm run build",
		"clean": "rm -rf dist",
		"codegen:version": "node genversion.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"doctor": "react-doctor --yes",
		"oxlint": "oxlint .",
		"oxlint:fix": "oxlint . --fix",
		"prettier": "prettier --check --ignore-unknown .",
		"prettier:fix": "prettier --write --ignore-unknown .",
		"lint": "pnpm run oxlint && pnpm run prettier",
		"lint:fix": "pnpm run oxlint:fix && pnpm run prettier:fix"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Suigar-Gaming/ts-sdks.git",
		"directory": "packages/mcp"
	},
	"publishConfig": {
		"access": "public"
	},
	"bugs": {
		"url": "https://github.com/Suigar-Gaming/ts-sdks/issues/new"
	},
	"homepage": "https://suigar.com/docs/mcp",
	"dependencies": {
		"@modelcontextprotocol/ext-apps": "1.7.4",
		"@modelcontextprotocol/sdk": "1.29.0",
		"@mysten/sui": "catalog:mysten",
		"@suigar/sdk": "workspace:^",
		"clsx": "catalog:frontend",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend",
		"tailwind-merge": "catalog:frontend",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@tailwindcss/vite": "catalog:tooling",
		"@types/node": "catalog:typescript",
		"@types/react": "catalog:typescript",
		"@types/react-dom": "catalog:typescript",
		"@vitejs/plugin-react": "^6.0.3",
		"react-doctor": "catalog:tooling",
		"tailwindcss": "catalog:tooling",
		"tsdown": "catalog:tooling",
		"typescript": "catalog:typescript",
		"vite": "^8.1.5",
		"vite-plugin-singlefile": "^2.3.3",
		"vitest": "catalog:test"
	}
}
