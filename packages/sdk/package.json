{
	"name": "@suigar/sdk",
	"version": "2.0.0-beta.26",
	"description": "TypeScript SDK for Suigar v2 Move contracts on Sui.",
	"keywords": [
		"suigar",
		"sui",
		"sui-sdk",
		"typescript",
		"move",
		"web3",
		"games"
	],
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"CHANGELOG.md",
		"README.md"
	],
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./games": {
			"types": "./dist/games.d.mts",
			"import": "./dist/games.mjs",
			"default": "./dist/games.mjs"
		},
		"./utils": {
			"types": "./dist/utils.d.mts",
			"import": "./dist/utils.mjs",
			"default": "./dist/utils.mjs"
		}
	},
	"engines": {
		"node": "^22.18.0 || >=24.0.0"
	},
	"scripts": {
		"build": "pnpm run clean && pnpm run codegen && tsdown",
		"build:ci": "pnpm run clean && tsdown",
		"clean": "rm -rf dist",
		"codegen": "tsx ./scripts/update-package-configs.ts && sui-ts-codegen generate && pnpm run lint:fix",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"oxlint": "oxlint .",
		"oxlint:fix": "oxlint . --fix",
		"prettier": "prettier --check --ignore-unknown .",
		"prettier:fix": "prettier --write --ignore-unknown .",
		"lint": "pnpm run oxlint && pnpm run prettier",
		"lint:fix": "pnpm run oxlint:fix && pnpm run prettier:fix"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Suigar-Gaming/ts-sdks.git",
		"directory": "packages/sdk"
	},
	"publishConfig": {
		"access": "public"
	},
	"bugs": {
		"url": "https://github.com/Suigar-Gaming/ts-sdks/issues"
	},
	"homepage": "https://suigar.com/docs/sdk",
	"peerDependencies": {
		"@mysten/bcs": "catalog:mysten",
		"@mysten/sui": "catalog:mysten"
	},
	"devDependencies": {
		"@mysten/bcs": "catalog:mysten",
		"@mysten/codegen": "catalog:mysten",
		"@mysten/sui": "catalog:mysten",
		"@types/node": "catalog:typescript",
		"tsdown": "catalog:tooling",
		"tsx": "catalog:tooling",
		"typescript": "catalog:typescript",
		"vitest": "catalog:test"
	}
}
