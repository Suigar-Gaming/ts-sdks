{
	"name": "@suigar/sdk",
	"version": "2.0.0-beta.16",
	"description": "TypeScript SDK for Suigar v2 Move contracts on Sui.",
	"keywords": [
		"suigar",
		"sui",
		"sui-sdk",
		"typescript",
		"move",
		"web3",
		"games"
	],
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"CHANGELOG.md",
		"README.md"
	],
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./games": {
			"types": "./dist/games.d.mts",
			"import": "./dist/games.mjs",
			"default": "./dist/games.mjs"
		},
		"./utils": {
			"types": "./dist/utils.d.mts",
			"import": "./dist/utils.mjs",
			"default": "./dist/utils.mjs"
		}
	},
	"engines": {
		"node": "^22.18.0 || >=24"
	},
	"scripts": {
		"build": "pnpm clean && pnpm codegen && tsdown",
		"build:ci": "rm -rf dist && tsdown",
		"clean": "rm -rf dist src/contracts .vitest-cache",
		"codegen": "node ./scripts/update-package-configs.mjs && sui-ts-codegen generate && pnpm lint",
		"eslint:fix": "eslint . --fix",
		"format": "pnpm prettier:fix",
		"lint": "pnpm eslint:fix && pnpm prettier:fix",
		"prettier:fix": "prettier --write --ignore-unknown .",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Suigar-Gaming/sdk.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"bugs": {
		"url": "https://github.com/Suigar-Gaming/sdk/issues"
	},
	"homepage": "https://docs.suigar.com/sdk",
	"peerDependencies": {
		"@mysten/bcs": "^2.0.5",
		"@mysten/sui": "^2.16.2"
	},
	"devDependencies": {
		"@mysten/bcs": "^2.0.5",
		"@mysten/codegen": "^0.10.6",
		"@mysten/sui": "^2.16.2",
		"@types/node": "^24.0.0",
		"tsdown": "^0.22.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.6"
	}
}
