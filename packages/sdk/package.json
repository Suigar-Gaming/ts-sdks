{
	"name": "@suigar/sdk",
	"version": "2.0.0-beta.39",
	"description": "TypeScript SDK for Suigar provably fair on-chain Sui casino game, SweetHouse, NFT, and referral transactions.",
	"keywords": [
		"betting",
		"casino",
		"casino-games",
		"coinflip",
		"crypto-casino",
		"dapp",
		"gamblefi",
		"games",
		"limbo",
		"move",
		"move-contracts",
		"nft",
		"on-chain",
		"plinko",
		"provably-fair",
		"pvp",
		"pvp-coinflip",
		"range",
		"referral",
		"soccer",
		"sui",
		"sui-blockchain",
		"sui-casino",
		"sui-sdk",
		"suigar",
		"transaction-builder",
		"transactions",
		"typescript",
		"web3",
		"web3-gaming",
		"wheel"
	],
	"homepage": "https://suigar.com/docs/sdk",
	"bugs": {
		"url": "https://github.com/Suigar-Gaming/ts-sdks/issues/new"
	},
	"license": "Apache-2.0",
	"author": "Suigar Gaming <contact.suigar@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Suigar-Gaming/ts-sdks.git",
		"directory": "packages/sdk"
	},
	"files": [
		"dist",
		"CHANGELOG.md",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./games": {
			"types": "./dist/games.d.mts",
			"import": "./dist/games.mjs",
			"default": "./dist/games.mjs"
		},
		"./utils": {
			"types": "./dist/utils.d.mts",
			"import": "./dist/utils.mjs",
			"default": "./dist/utils.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "pnpm run clean && pnpm run codegen && tsdown",
		"build:ci": "pnpm run clean && tsdown",
		"clean": "rimraf dist",
		"codegen": "sui-ts-codegen generate && pnpm run lint:fix",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"publish:jsr": "jsr publish --allow-slow-types",
		"oxlint": "oxlint .",
		"oxlint:fix": "oxlint . --fix",
		"oxfmt": "oxfmt . --check",
		"oxfmt:fix": "oxfmt .",
		"lint": "pnpm run oxlint && pnpm run oxfmt",
		"lint:fix": "pnpm run oxlint:fix && pnpm run oxfmt:fix"
	},
	"devDependencies": {
		"@mysten/bcs": "catalog:mysten",
		"@mysten/codegen": "catalog:mysten",
		"@mysten/sui": "catalog:mysten",
		"@types/node": "catalog:typescript",
		"tsdown": "catalog:tooling",
		"typescript": "catalog:typescript",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@mysten/bcs": "catalog:mysten",
		"@mysten/sui": "catalog:mysten"
	},
	"engines": {
		"node": "^24.0.0 || ^26.0.0"
	}
}
